{
  "agents": [
    {
      "agent_id": "research-plan",
      "context_id": "research-plan-context",
      "description": "Turns one research question into a bounded, closed assignment set.",
      "display_name": "Web research planner",
      "inference_profile_id": "gents:inference-slot:coordinator"
    },
    {
      "agent_id": "research-investigate",
      "context_id": "research-investigate-context",
      "description": "Searches, extracts, and records evidence for one bounded research lens.",
      "display_name": "Web evidence investigator",
      "inference_profile_id": "gents:inference-slot:researcher"
    },
    {
      "agent_id": "research-adjudicate",
      "context_id": "research-adjudicate-context",
      "description": "Cross-checks claims, contradictions, provenance, and quote support.",
      "display_name": "Research evidence adjudicator",
      "inference_profile_id": "gents:inference-slot:verifier"
    },
    {
      "agent_id": "research-report",
      "context_id": "research-report-context",
      "description": "Writes the final answer from adjudicated claims and source provenance.",
      "display_name": "Cited research reporter",
      "inference_profile_id": "gents:inference-slot:coordinator"
    }
  ],
  "node": {},
  "compactions": [
    {
      "compaction_id": "research-compaction",
      "threshold": 0.85
    }
  ],
  "contexts": [
    {
      "compaction_id": "research-compaction",
