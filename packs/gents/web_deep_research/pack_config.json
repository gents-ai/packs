  "datastore_tool_surfaces": [
    {
      "display_name": "Research plan and closed assignment writes",
      "entries": [
        {
          "collection": "WebResearchAssignment",
          "description": "Create one member of the closed parallel investigation set.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "name": "assignment_id",
              "required": true
            },
            {
              "name": "question",
              "required": true
            },
            {
              "name": "lens",
              "required": true
            },
            {
              "name": "instructions",
              "required": true
            },
            {
              "name": "query_plan",
              "required": true
            },
            {
              "name": "source_requirements",
              "required": true
            },
            {
              "name": "freshness",
              "required": true
            },
            {
              "name": "expected_total",
              "required": true
            }
          ],
          "output_obligation": {
            "expected_count_field": "expected_total",
            "minimum_writes": 1,
            "scope": "trigger"
          },
          "tool_name": "write_research_assignment"
        },
        {
          "collection": "WebResearchPlan",
          "description": "Persist the bounded research strategy after the assignment ledger is complete.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "name": "question",
              "required": true
            },
            {
              "name": "strategy",
              "required": true
            },
            {
              "name": "source_hierarchy",
              "required": true
            },
            {
              "name": "coverage_requirements",
              "required": true
            },
            {
              "name": "assignment_count",
              "required": true
            }
          ],
          "output_obligation": {
            "minimum_writes": 1,
            "scope": "trigger"
          },
          "tool_name": "write_research_plan"
        }
      ],
      "surface_id": "research-plan-writes"
    },
