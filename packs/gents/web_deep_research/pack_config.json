  "graph_intents": [
    {
      "edges": [
        {
          "concurrency": "parallel",
          "from": {
            "node_id": "plan",
            "port": "assignments"
          },
          "to": {
            "node_id": "investigate",
            "port": "assignment"
          }
        },
        {
          "concurrency": "serial",
          "delivery": {
            "expected_count": {
              "source_field": "expected_total"
            }
          },
          "from": {
            "node_id": "investigate",
            "port": "investigations"
          },
          "to": {
            "node_id": "adjudicate",
            "port": "investigations"
          }
        },
        {
          "concurrency": "serial",
          "from": {
            "node_id": "adjudicate",
            "port": "draft"
          },
          "to": {
            "node_id": "report",
            "port": "draft"
          }
        }
      ],
      "entries": [
        {
          "collection": "WebResearchJob",
          "input_contract": "web-research-input/v1",
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question"
            ],
            "properties": {
              "question": {
                "type": "string",
                "pattern": "\\S"
              },
              "scope": {
                "type": "string",
                "default": "Answer the question directly; include material context, counterevidence, and uncertainty."
              },
              "freshness": {
                "type": "string",
                "default": "Prefer current sources and record publication dates; retain older primary sources when historically necessary."
              },
              "audience": {
                "type": "string",
                "default": "A technically literate reader"
              },
              "output_requirements": {
                "type": "string",
                "default": "A concise Markdown report with claim-local links, counterevidence, a source ledger, and explicit limitations."
              },
              "investigator_count": {
                "type": "string",
                "pattern": "^[2-8]$",
                "default": "4"
              }
            }
          },
          "name": "research",
          "schema": "WebResearchJob/v1",
          "to": {
            "node_id": "plan",
            "port": "job"
          }
        }
      ],
      "graph_id": "web-deep-research",
      "limits": {
        "max_depth": 8,
        "max_edges": 16,
        "max_fan_out": 8,
        "max_nodes": 8,
        "max_runtime_secs": 7200,
        "max_total_invocations": 32
      },
