    {
      "behaviors": [
        "review-scan"
      ],
      "description": "Bounded parallel code-review scans. A fast, capable worker profile is appropriate.",
      "name": "worker"
    },
    {
      "behaviors": [
        "review-verify"
      ],
      "description": "Adversarial verification of candidate findings. Prefer an independent high-quality profile.",
      "name": "verifier"
    }
  ],
