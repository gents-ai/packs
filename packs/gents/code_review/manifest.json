{
  "assets": [
    "README.md",
    "agent_behaviors/review_recon/system_prompt.md",
    "agent_behaviors/review_scan/system_prompt.md",
    "agent_behaviors/review_triage/system_prompt.md",
    "agent_behaviors/review_verify/system_prompt.md",
    "pack_config.json",
    "plugins/review_changes.afb",
    "plugins/review_changes/TOOL.md",
    "plugins/review_changes/tests/00_step0_budget_pause.json",
    "plugins/review_changes/tests/00b_step0_spawn_ceiling_pause.json",
    "plugins/review_changes/tests/01_step0_spawn_recon.json",
    "plugins/review_changes/tests/02_recon_live_waits.json",
    "plugins/review_changes/tests/03_recon_done_asks_for_text.json",
    "plugins/review_changes/tests/03b_round_request_carries_corrections.json",
    "plugins/review_changes/tests/04_recon_error_text_blocks.json",
    "plugins/review_changes/tests/05_empty_diff_completes.json",
    "plugins/review_changes/tests/06_recon_ok_spawns_scans.json",
    "plugins/review_changes/tests/06b_recon_ok_windows_scans_to_max_live.json",
    "plugins/review_changes/tests/06c_scans_live_waits.json",
    "plugins/review_changes/tests/07_scans_done_spawns_verify.json",
    "plugins/review_changes/tests/08_no_candidates_spawns_triage.json",
    "plugins/review_changes/tests/09_verify_done_spawns_triage.json",
    "plugins/review_changes/tests/10_triage_done_completes.json",
    "plugins/review_changes/tests/11_bad_recon_reply_is_corrected.json",
    "plugins/review_changes/tests/12_second_bad_recon_reply_blocks.json",
    "plugins/review_changes/tests/13_triage_failed_still_completes.json",
    "plugins/review_changes/tests/14_old_success_state_requests_latest_text.json",
    "tests/content.json",
    "tests/install.json"
  ],
  "authors": [
    "gents-ai contributors"
  ],
  "config": "pack_config.json",
  "dependencies": [],
  "description": "Four-stage code review personas (recon, scan, verify, triage) and the review_changes job plugin that drives them.",
  "inference_slots": [
    {
      "agents": [
        "review-recon",
        "review-triage"
      ],
      "description": "Planning, evidence triage, and final review. Prefer a strong reasoning profile.",
      "name": "coordinator"
    },
    {
      "agents": [
        "review-scan"
      ],
      "description": "Bounded parallel code-review scans. A fast, capable worker profile is appropriate.",
      "name": "worker"
    },
    {
      "agents": [
        "review-verify"
      ],
      "description": "Adversarial verification of candidate findings. Prefer an independent high-quality profile.",
      "name": "verifier"
    }
  ],
  "kind": "documents",
  "manifest_version": 1,
  "name": "code_review",
  "namespace": "gents",
  "plugins": [
    {
      "artifact": "plugins/review_changes.afb",
      "description": "Review a git change through four lenses, adversarially verify every candidate and triage; runs as a background job.",
      "input_schema": {
        "properties": {
          "agent_budget": {
            "maximum": 1024,
            "minimum": 1,
            "type": "integer"
          },
          "args": {
            "description": "base, head, repository, focus",
            "properties": {
              "base": {
                "type": "string"
              },
              "focus": {
                "type": "string"
              },
              "head": {
                "type": "string"
              },
              "repository": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "instructions": "plugins/review_changes/TOOL.md",
      "job": true,
      "language": "rust",
      "limits": {
        "max_output_mib": 4,
        "memory_mib": 256,
        "wall_clock_secs": 120
      },
      "name": "review_changes",
      "source": "plugins/review_changes"
    }
  ],
  "tags": [
    "review",
    "workflow"
  ],
  "version": "2.0.0"
}
