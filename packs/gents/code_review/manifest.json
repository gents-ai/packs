{
  "assets": [
    "README.md",
    "agent_behaviors/review_recon/system_prompt.md",
    "agent_behaviors/review_scan/system_prompt.md",
    "agent_behaviors/review_triage/system_prompt.md",
    "agent_behaviors/review_verify/system_prompt.md",
    "graphs/code_review.plan.json",
    "pack_config.json",
    "plugins/review_evidence.afb",
    "schemas/candidate_finding.graphql",
    "schemas/evidence_manifest.graphql",
    "schemas/evidence_page.graphql",
    "schemas/finding.graphql",
    "schemas/finding_verdict.graphql",
    "schemas/review_area.graphql",
    "schemas/review_job.graphql",
    "schemas/scan_result.graphql",
    "schemas/triage_report.graphql",
    "schemas/verification_summary.graphql",
    "tasks/review_recon_task/prompt.md",
    "tasks/review_scan_task/prompt.md",
    "tasks/review_triage_task/prompt.md",
    "tasks/review_verify_task/prompt.md",
    "tests/graphs.json"
  ],
  "authors": [
    "gents-ai contributors"
  ],
  "compiler_version": "graph-intent-v4",
  "config": "pack_config.json",
  "dependencies": [],
  "description": "Host-evidenced four-stage review: deterministic dispatch, immutable paged evidence, bounded lens swarm, verification, and triage.",
  "inference_slots": [
    {
      "behaviors": [
        "review-recon",
        "review-triage"
      ],
      "description": "Planning, evidence triage, and final review. Prefer a strong reasoning profile.",
      "name": "coordinator"
    },
    {
      "behaviors": [
        "review-scan"
      ],
      "description": "Bounded parallel code-review scans. A fast, capable worker profile is appropriate.",
      "name": "worker"
    },
    {
      "behaviors": [
        "review-verify"
      ],
      "description": "Adversarial verification of candidate findings. Prefer an independent high-quality profile.",
      "name": "verifier"
    }
  ],
  "kind": "graph",
  "manifest_version": 1,
  "name": "code_review",
  "namespace": "gents",
  "plugins": [
    {
      "artifact": "plugins/review_evidence.afb",
      "description": "Turns the review entry's collected git_diff and read_only_workspace host facts into the immutable paged evidence documents and the review job's actual input. Runs only as this entry's declared prepare step, never as a direct model tool.",
      "input_schema": {
        "type": "object",
        "description": "The host prepare envelope: the admitted entry input, a per-run nonce, and the collected git_diff and read_only_workspace host facts.",
        "properties": {
          "input": {
            "type": "object"
          },
          "nonce": {
            "type": "string"
          },
          "host": {
            "type": "object"
          }
        },
        "required": [
          "input",
          "nonce",
          "host"
        ],
        "additionalProperties": false
      },
      "language": "rust",
      "limits": {
        "memory_mib": 1024,
        "wall_clock_secs": 120,
        "max_output_mib": 4
      },
      "name": "review_evidence",
      "source": "plugins/review_evidence"
    }
  ],
  "schemas": [
    "schemas/review_job.graphql",
    "schemas/evidence_manifest.graphql",
    "schemas/evidence_page.graphql",
    "schemas/review_area.graphql",
    "schemas/candidate_finding.graphql",
    "schemas/scan_result.graphql",
    "schemas/finding_verdict.graphql",
    "schemas/finding.graphql",
    "schemas/verification_summary.graphql",
    "schemas/triage_report.graphql"
  ],
  "tags": [
    "graph"
  ],
  "version": "1.7.0"
}
