{
  "agent_behaviors": [
    {
      "behavior_id": "review-recon",
      "context_id": "review-recon-context",
      "description": "Partitions a repository review into a closed set of areas.",
      "display_name": "Review reconnaissance",
      "inference_profile_id": "gents:inference-slot:coordinator"
    },
    {
      "behavior_id": "review-scan",
      "context_id": "review-scan-context",
      "description": "Inspects one repository area and records findings.",
      "display_name": "Review area scanner",
      "inference_profile_id": "gents:inference-slot:worker"
    },
    {
      "behavior_id": "review-verify",
      "context_id": "review-verify-context",
      "description": "Refutes or confirms every candidate against freshly read code.",
      "display_name": "Adversarial review verification",
      "inference_profile_id": "gents:inference-slot:verifier"
    },
    {
      "behavior_id": "review-triage",
      "context_id": "review-triage-context",
      "description": "Ranks verified findings and writes the final report.",
      "display_name": "Review triage",
      "inference_profile_id": "gents:inference-slot:coordinator"
    }
  ],
  "agent_principal": {},
  "compactions": [
    {
      "compaction_id": "review-compaction",
      "threshold": 0.85
    }
  ],
  "contexts": [
    {
      "compaction_id": "review-compaction",
      "context_id": "review-recon-context",
      "system_prompt": "./agent_behaviors/review_recon/system_prompt.md",
      "tools_id": "review-recon-tools"
    },
    {
      "compaction_id": "review-compaction",
      "context_id": "review-scan-context",
      "system_prompt": "./agent_behaviors/review_scan/system_prompt.md",
      "tools_id": "review-scan-tools"
    },
    {
      "compaction_id": "review-compaction",
      "context_id": "review-verify-context",
      "system_prompt": "./agent_behaviors/review_verify/system_prompt.md",
      "tools_id": "review-verify-tools"
    },
    {
      "compaction_id": "review-compaction",
      "context_id": "review-triage-context",
      "system_prompt": "./agent_behaviors/review_triage/system_prompt.md",
      "tools_id": "review-triage-tools"
    }
  ],
  "datastore_tool_surfaces": [
    {
      "display_name": "Review area writes",
      "entries": [
        {
          "collection": "CodeReviewArea",
          "description": "Create one member of the closed review-area set.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "name": "area_id",
              "required": true
            },
            {
              "fill": {
                "source_field": "repository_path"
              },
              "name": "repository_path",
              "required": false
            },
            {
              "fill": {
                "source_field": "evidence_id"
              },
              "name": "evidence_id",
              "required": false
            },
            {
              "name": "lens",
              "required": true
            },
            {
              "name": "path",
              "required": true
            },
            {
              "name": "instructions",
              "required": true
            },
            {
              "name": "baseline",
              "required": true
            },
            {
              "name": "expected_total",
              "required": true
            }
          ],
          "output_obligation": {
            "expected_count_field": "expected_total",
            "minimum_writes": 1,
            "scope": "trigger"
          },
          "tool_name": "write_review_area"
        }
      ],
      "surface_id": "review-recon-writes"
    },
    {
      "display_name": "Immutable review evidence reads and finding writes",
      "entries": [
        {
          "collection": "CodeReviewEvidenceManifest",
          "description": "Read the exact immutable manifest for this review run before reading evidence pages.",
          "fields": [
            "evidence_id",
            "format_version",
            "page_count",
            "evidence_chunk_count",
            "evidence_byte_count",
            "evidence_sha256"
          ],
          "filter_fields": [
            {
              "fill": {
                "source_field": "evidence_id"
              },
              "name": "evidence_id",
              "required": false
            }
          ],
          "kind": "query",
          "tool_name": "read_review_evidence_manifest"
        },
        {
          "collection": "CodeReviewEvidencePage",
          "description": "Read one exact immutable host-evidence page for this review run.",
          "fields": [
            "page_key",
            "evidence_id",
            "page_index",
            "page_count",
            "evidence_chunk_count",
            "evidence_byte_count",
            "evidence_sha256",
            "evidence_chunk_0",
            "evidence_chunk_1",
            "evidence_chunk_2",
            "evidence_chunk_3",
            "evidence_chunk_4",
            "evidence_chunk_5",
            "evidence_chunk_6",
            "evidence_chunk_7",
            "evidence_chunk_8",
            "evidence_chunk_9",
            "evidence_chunk_10",
            "evidence_chunk_11",
            "evidence_chunk_12",
            "evidence_chunk_13",
            "evidence_chunk_14",
            "evidence_chunk_15"
          ],
          "filter_fields": [
            {
              "fill": {
                "source_field": "evidence_id"
              },
              "name": "evidence_id",
              "required": false
            },
            {
              "name": "page_index",
              "required": true
            }
          ],
          "kind": "query",
          "tool_name": "read_review_evidence_page"
        },
        {
          "collection": "CodeReviewCandidateFinding",
          "description": "Record one evidenced Critical, Major, or Cleanup candidate for adversarial verification.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "fill": {
                "source_field": "area_id"
              },
              "name": "area_id",
              "required": false
            },
            {
              "name": "finding_id",
              "required": true
            },
            {
              "name": "severity",
              "required": true
            },
            {
              "name": "title",
              "required": true
            },
            {
              "name": "path",
              "required": true
            },
            {
              "name": "line",
              "required": false
            },
            {
              "name": "evidence",
              "required": true
            },
            {
              "name": "detail",
              "required": true
            },
            {
              "name": "confidence",
              "required": true
            }
          ],
          "tool_name": "write_candidate_finding"
        },
        {
          "collection": "CodeReviewScanResult",
          "description": "Close this lens after every evidence page was read and candidate writes are durable.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "fill": {
                "source_field": "area_id"
              },
              "name": "area_id",
              "required": false
            },
            {
              "name": "summary",
              "required": true
            },
            {
              "fill": {
                "source_field": "expected_total"
              },
              "name": "expected_total",
              "required": false
            }
          ],
          "output_obligation": {
            "minimum_writes": 1,
            "scope": "trigger"
          },
          "tool_name": "write_scan_result"
        }
      ],
      "surface_id": "review-scan-writes"
    },
    {
      "display_name": "Verification reads and decision writes",
      "entries": [
        {
          "collection": "CodeReviewCandidateFinding",
          "description": "Load every candidate finding for this run. run_id is filled by the runtime.",
          "fields": [
            "finding_id",
            "area_id",
            "severity",
            "confidence",
            "path",
            "line",
            "title",
            "detail",
            "evidence"
          ],
          "filter_fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            }
          ],
          "kind": "query",
          "tool_name": "read_candidate_finding"
        },
        {
          "collection": "CodeReviewFindingVerdict",
          "description": "Persist one confirmed or refuted decision for a candidate finding.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "name": "finding_id",
              "required": true
            },
            {
              "name": "area_id",
              "required": true
            },
            {
              "name": "severity",
              "required": true
            },
            {
              "name": "confidence",
              "required": true
            },
            {
              "name": "path",
              "required": true
            },
            {
              "name": "line",
              "required": false
            },
            {
              "name": "title",
              "required": true
            },
            {
              "name": "detail",
              "required": true
            },
            {
              "name": "verdict",
              "required": true
            },
            {
              "name": "evidence",
              "required": true
            },
            {
              "name": "verification",
              "required": true
            }
          ],
          "tool_name": "write_finding_verdict"
        },
        {
          "collection": "CodeReviewFinding",
          "description": "Promote one confirmed verdict into the operator-facing CodeReviewFinding collection. Call only for verdict=confirmed.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "name": "finding_id",
              "required": true
            },
            {
              "name": "area_id",
              "required": true
            },
            {
              "name": "severity",
              "required": true
            },
            {
              "name": "confidence",
              "required": true
            },
            {
              "name": "path",
              "required": true
            },
            {
              "name": "line",
              "required": false
            },
            {
              "name": "title",
              "required": true
            },
            {
              "name": "detail",
              "required": true
            },
            {
              "name": "verdict",
              "required": true
            },
            {
              "name": "evidence",
              "required": true
            },
            {
              "name": "verification",
              "required": true
            }
          ],
          "tool_name": "write_finding"
        },
        {
          "collection": "CodeReviewVerificationSummary",
          "description": "Close the verification ledger and trigger final triage.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "name": "candidate_count",
              "required": true
            },
            {
              "name": "confirmed_count",
              "required": true
            },
            {
              "name": "refuted_count",
              "required": true
            },
            {
              "name": "summary",
              "required": true
            }
          ],
          "output_obligation": {
            "minimum_writes": 1,
            "scope": "trigger"
          },
          "tool_name": "write_verification_summary"
        }
      ],
      "surface_id": "review-verify-writes"
    },
    {
      "display_name": "Triage reads and report writes",
      "entries": [
        {
          "collection": "CodeReviewFinding",
          "description": "Load every operator-facing CodeReviewFinding for this run. run_id is filled by the runtime.",
          "fields": [
            "finding_id",
            "area_id",
            "severity",
            "confidence",
            "path",
            "line",
            "title",
            "detail",
            "verdict",
            "evidence",
            "verification"
          ],
          "filter_fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            }
          ],
          "kind": "query",
          "tool_name": "read_finding"
        },
        {
          "collection": "CodeReviewTriageReport",
          "description": "Create the single count-balanced final report for this correlated review run; run_id is filled by the runtime.",
          "fields": [
            {
              "fill": "correlation",
              "name": "run_id",
              "required": false
            },
            {
              "name": "high_priority_count",
              "required": true
            },
            {
              "name": "confirmed_count",
              "required": true
            },
            {
              "name": "refuted_count",
              "required": true
            },
            {
              "name": "summary",
              "required": true
            }
          ],
          "output_obligation": {
            "minimum_writes": 1,
            "scope": "trigger"
          },
          "tool_name": "write_triage_report"
        }
      ],
      "surface_id": "review-triage-writes"
    }
  ],
  "graph_capabilities": [
    {
      "allowed_callers": [
        "${GENTS_PACK_AGENT_DID}"
      ],
      "capability_id": "review-recon",
      "input_ports": [
        {
          "cardinality": "one",
          "collection": "CodeReviewJob",
          "correlation_field": "run_id",
          "name": "job",
          "required": true,
          "schema": "CodeReviewJob/v1"
        }
      ],
      "output_ports": [
        {
          "cardinality": "one",
          "collection": "CodeReviewArea",
          "correlation_field": "run_id",
          "name": "areas",
          "schema": "CodeReviewArea/v1"
        }
      ],
      "revision": "v1",
      "target": {
        "kind": "task",
        "task_id": "review-recon-task"
      },
      "workspace_authority": "readOnly"
    },
    {
      "allowed_callers": [
        "${GENTS_PACK_AGENT_DID}"
      ],
      "capability_id": "review-scan",
      "input_ports": [
        {
          "cardinality": "one",
          "collection": "CodeReviewArea",
          "correlation_field": "run_id",
          "name": "area",
          "required": true,
          "schema": "CodeReviewArea/v1"
        }
      ],
      "output_ports": [
        {
          "cardinality": "one",
          "collection": "CodeReviewScanResult",
          "correlation_field": "run_id",
          "name": "scan_results",
          "schema": "CodeReviewScanResult/v1"
        },
        {
          "cardinality": "many",
          "collection": "CodeReviewCandidateFinding",
          "correlation_field": "run_id",
          "name": "candidates",
          "schema": "CodeReviewCandidateFinding/v1"
        }
      ],
      "revision": "v1",
      "target": {
        "kind": "task",
        "task_id": "review-scan-task"
      },
      "workspace_authority": "readOnly"
    },
    {
      "allowed_callers": [
        "${GENTS_PACK_AGENT_DID}"
      ],
      "capability_id": "review-verify",
      "input_ports": [
        {
          "cardinality": "many",
          "collection": "CodeReviewScanResult",
          "correlation_field": "run_id",
          "name": "scan_results",
          "required": true,
          "schema": "CodeReviewScanResult/v1"
        }
      ],
      "output_ports": [
        {
          "cardinality": "one",
          "collection": "CodeReviewVerificationSummary",
          "correlation_field": "run_id",
          "name": "summary",
          "schema": "CodeReviewVerificationSummary/v1"
        },
        {
          "cardinality": "many",
          "collection": "CodeReviewFindingVerdict",
          "correlation_field": "run_id",
          "name": "verdicts",
          "schema": "CodeReviewFindingVerdict/v1"
        },
        {
          "cardinality": "many",
          "collection": "CodeReviewFinding",
          "correlation_field": "run_id",
          "name": "findings",
          "schema": "CodeReviewFinding/v1"
        }
      ],
      "revision": "v1",
      "target": {
        "kind": "task",
        "task_id": "review-verify-task"
      },
      "workspace_authority": "readOnly"
    },
    {
      "allowed_callers": [
        "${GENTS_PACK_AGENT_DID}"
      ],
      "capability_id": "review-triage",
      "input_ports": [
        {
          "cardinality": "one",
          "collection": "CodeReviewVerificationSummary",
          "correlation_field": "run_id",
          "name": "summary",
          "required": true,
          "schema": "CodeReviewVerificationSummary/v1"
        }
      ],
      "output_ports": [
        {
          "cardinality": "one",
          "collection": "CodeReviewTriageReport",
          "correlation_field": "run_id",
          "name": "report",
          "schema": "CodeReviewTriageReport/v1"
        }
      ],
      "revision": "v1",
      "target": {
        "kind": "task",
        "task_id": "review-triage-task"
      }
    }
  ],
  "graph_intents": [
    {
      "edges": [
        {
          "concurrency": "parallel",
          "from": {
            "node_id": "recon",
            "port": "areas"
          },
          "to": {
            "node_id": "scan",
            "port": "area"
          }
        },
        {
          "concurrency": "serial",
          "delivery": {
            "expected_count": {
              "source_field": "expected_total"
            }
          },
          "from": {
            "node_id": "scan",
            "port": "scan_results"
          },
          "to": {
            "node_id": "verify",
            "port": "scan_results"
          }
        },
        {
          "concurrency": "serial",
          "from": {
            "node_id": "verify",
            "port": "summary"
          },
          "to": {
            "node_id": "triage",
            "port": "summary"
          }
        }
      ],
      "entries": [
        {
          "collection": "CodeReviewJob",
          "input_contract": "review-input/v1",
          "name": "review",
          "schema": "CodeReviewJob/v1",
          "to": {
            "node_id": "recon",
            "port": "job"
          }
        }
      ],
      "graph_id": "code-review",
      "limits": {
        "max_depth": 8,
        "max_edges": 16,
        "max_fan_out": 16,
        "max_nodes": 8,
        "max_runtime_secs": 7200,
        "max_total_invocations": 128
      },
      "nodes": [
        {
          "capability_id": "review-recon",
          "capability_revision": "v1",
          "node_id": "recon"
        },
        {
          "capability_id": "review-scan",
          "capability_revision": "v1",
          "node_id": "scan"
        },
        {
          "capability_id": "review-verify",
          "capability_revision": "v1",
          "node_id": "verify"
        },
        {
          "capability_id": "review-triage",
          "capability_revision": "v1",
          "node_id": "triage"
        }
      ],
      "results": [
        {
          "cardinality": {
            "count": 128,
            "kind": "at_most"
          },
          "from": {
            "node_id": "verify",
            "port": "findings"
          },
          "name": "findings",
          "terminal": true
        },
        {
          "cardinality": {
            "count": 1,
            "kind": "exactly"
          },
          "from": {
            "node_id": "triage",
            "port": "report"
          },
          "name": "report",
          "terminal": true
        }
      ]
    }
  ],
  "graphs": [
    {
      "graph_id": "code-review"
    }
  ],
  "tasks": [
    {
      "behavior_id": "review-recon",
      "display_name": "Partition repository review",
      "goal_objective_template": "Dispatch all four host-evidenced review lenses for run {{ event.correlation }}, persist the complete area ledger, then complete this Goal.",
      "prompt_template": "./tasks/review_recon_task/prompt.md",
      "task_id": "review-recon-task"
    },
    {
      "behavior_id": "review-scan",
      "display_name": "Scan one review area",
      "goal_objective_template": "Finish the {{ doc.lens }} review for area {{ doc.area_id }} in run {{ event.correlation }}. Persist at most three supported candidates, or none when no defects are supported, and the mandatory scan-result sentinel for this exact area; then complete this Goal.",
      "prompt_template": "./tasks/review_scan_task/prompt.md",
      "task_id": "review-scan-task"
    },
    {
      "behavior_id": "review-verify",
      "display_name": "Verify completed review candidates",
      "goal_objective_template": "Close verification for run {{ group.correlation_value }} across its {{ group.count }} completed scans. Persist one supported verdict per candidate, promote only confirmed findings, and publish the balanced verification summary, including zero candidates; then complete this Goal.",
      "prompt_template": "./tasks/review_verify_task/prompt.md",
      "task_id": "review-verify-task"
    },
    {
      "behavior_id": "review-triage",
      "display_name": "Write the merge report",
      "goal_objective_template": "Publish the final triage report for run {{ event.correlation }} matching its closed verification ledger ({{ doc.candidate_count }} candidates, {{ doc.confirmed_count }} confirmed, {{ doc.refuted_count }} refuted), then complete this Goal.",
      "prompt_template": "./tasks/review_triage_task/prompt.md",
      "task_id": "review-triage-task"
    }
  ],
  "tools": [
    {
      "built_ins": {
        "enable_goal_tools": true
      },
      "datastore": {
        "datastore_tool_surface_ids": [
          "review-recon-writes"
        ]
      },
      "display_name": "Recon: dispatch immutable review lenses",
      "tools_id": "review-recon-tools"
    },
    {
      "built_ins": {
        "enable_goal_tools": true
      },
      "datastore": {
        "datastore_tool_surface_ids": [
          "review-scan-writes"
        ]
      },
      "display_name": "Scan: inspect immutable evidence and write results",
      "tools_id": "review-scan-tools"
    },
    {
      "built_ins": {
        "enable_context_budget": true,
        "enable_goal_tools": true
      },
      "datastore": {
        "datastore_tool_surface_ids": [
          "review-verify-writes"
        ]
      },
      "display_name": "Verify: inspect repository, read candidates, and write verdicts",
      "host": {
        "bash": {
          "background_enabled": true,
          "execution_mode": "artifact_write",
          "mode": "Unrestricted",
          "network_mode": "disabled"
        },
        "files": {
          "mode": "ReadOnly"
        }
      },
      "tools_id": "review-verify-tools"
    },
    {
      "built_ins": {
        "enable_context_budget": true,
        "enable_goal_tools": true
      },
      "datastore": {
        "datastore_tool_surface_ids": [
          "review-triage-writes"
        ]
      },
      "display_name": "Triage: read findings and write the merge report",
      "tools_id": "review-triage-tools"
    }
  ]
}
