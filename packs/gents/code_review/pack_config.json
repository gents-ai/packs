{
  "agents": [
    {
      "agent_id": "review-recon",
      "context_id": "review-recon-context",
      "description": "Pins a git change: resolves base and head commits and trees and returns the git outputs.",
      "display_name": "Review reconnaissance",
      "inference_profile_id": "gents:inference-slot:coordinator"
    },
    {
      "agent_id": "review-scan",
      "context_id": "review-scan-context",
      "description": "Reviews a pinned git change through one lens and reports candidate defects.",
      "display_name": "Review area scanner",
      "inference_profile_id": "gents:inference-slot:worker"
    },
    {
      "agent_id": "review-verify",
      "context_id": "review-verify-context",
      "description": "Refutes or confirms every candidate against freshly read code.",
      "display_name": "Adversarial review verification",
      "inference_profile_id": "gents:inference-slot:verifier"
    },
    {
      "agent_id": "review-triage",
      "context_id": "review-triage-context",
      "description": "Ranks verified findings and writes the final report.",
      "display_name": "Review triage",
      "inference_profile_id": "gents:inference-slot:coordinator"
    }
  ],
  "node": {},
  "compactions": [
    {
      "compaction_id": "review-compaction",
      "threshold": 0.85
    }
  ],
  "contexts": [
    {
      "compaction_id": "review-compaction",
      "context_id": "review-recon-context",
      "system_prompt": "./agent_behaviors/review_recon/system_prompt.md",
      "tools_id": "review-recon"
    },
    {
      "compaction_id": "review-compaction",
      "context_id": "review-scan-context",
      "system_prompt": "./agent_behaviors/review_scan/system_prompt.md",
      "tools_id": "review-scan"
    },
    {
      "compaction_id": "review-compaction",
      "context_id": "review-verify-context",
      "system_prompt": "./agent_behaviors/review_verify/system_prompt.md",
      "tools_id": "review-verify-tools"
    },
    {
      "compaction_id": "review-compaction",
      "context_id": "review-triage-context",
      "system_prompt": "./agent_behaviors/review_triage/system_prompt.md",
      "tools_id": "review-triage"
    }
  ],
  "tools": [
    {
      "display_name": "Recon: pin the git change with read-only git",
      "host": {
        "bash": {
          "mode": "ReadOnly",
          "max_output_chars": 1000000
        },
        "files": {
          "mode": "Off"
        }
      },
      "tools_id": "review-recon",
      "built_ins": {
        "enable_session_history_tool": false
      }
    },
    {
      "display_name": "Scan: read the pinned change with read-only git",
      "host": {
        "bash": {
          "mode": "ReadOnly",
          "max_output_chars": 64000
        },
        "files": {
          "mode": "Off"
        }
      },
      "tools_id": "review-scan",
      "built_ins": {
        "enable_session_history_tool": false
      }
    },
    {
      "built_ins": {
        "enable_context_budget": true,
        "enable_session_history_tool": false
      },
      "display_name": "Verify: refute or confirm candidates and return verdicts",
      "host": {
        "bash": {
          "mode": "ReadOnly",
          "network_mode": "disabled"
        },
        "files": {
          "mode": "Off"
        }
      },
      "tools_id": "review-verify-tools"
    },
    {
      "display_name": "Triage: write the merge report",
      "built_ins": {
        "enable_context_budget": true,
        "enable_session_history_tool": false
      },
      "tools_id": "review-triage"
    },
    {
      "display_name": "Review caller: the review_changes job plugin wired to the four review targets",
      "tools_id": "review-changes-caller",
      "integrations": {
        "plugins": [
          {
            "plugin": "gents/review_changes",
            "job": {
              "agent_targets": [
                "code-review-recon",
                "code-review-scan",
                "code-review-verify",
                "code-review-triage"
              ],
              "max_live": 8,
              "max_spawns": 32,
              "max_messages_per_slot": 4,
              "result_bytes": 65536,
              "max_wall_secs": 7200
            }
          }
        ]
      }
    }
  ],
  "agent_targets": [
    {
      "agent_id": "review-recon",
      "description": "Pins a git change: resolves base and head commits and trees and returns the git outputs.",
      "name": "code-review-recon",
      "target_id": "code-review-recon",
      "target_node_did": "${GENTS_PACK_NODE_DID}"
    },
    {
      "agent_id": "review-scan",
      "description": "Reviews a pinned git change through one lens and reports candidate defects.",
      "name": "code-review-scan",
      "target_id": "code-review-scan",
      "target_node_did": "${GENTS_PACK_NODE_DID}"
    },
    {
      "agent_id": "review-verify",
      "description": "Refutes or confirms every candidate against freshly read code.",
      "name": "code-review-verify",
      "target_id": "code-review-verify",
      "target_node_did": "${GENTS_PACK_NODE_DID}"
    },
    {
      "agent_id": "review-triage",
      "description": "Ranks verified findings and writes the final report.",
      "name": "code-review-triage",
      "target_id": "code-review-triage",
      "target_node_did": "${GENTS_PACK_NODE_DID}"
    }
  ]
}
