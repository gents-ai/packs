  "event_sources": [
    {
      "correlation_field": "work_unit_id",
      "display_name": "Create isolated workspace",
      "event_kind": "created",
      "event_source_id": "change-unit-workspace",
      "filter": "{ status: { _eq: \"ready\" }, work_unit_id: { _like: \"change-unit:%\" }, handoff_id: { _like: \"change-unit:%\" }, reply_session_id: { _neq: \"\" } }",
      "source_collection": "ChangeUnitWork"
    },
    {
      "correlation_field": "work_unit_id",
      "display_name": "Implement Change",
      "event_kind": "created",
      "event_source_id": "change-unit-write",
      "filter": "{ binding_id: { _eq: \"change-unit-workspace\" }, work_unit_id: { _like: \"change-unit:%\" } }",
      "source_collection": "CallbackResult",
      "workspace_authority": "readWrite"
    },
    {
      "correlation_field": "work_unit_id",
      "display_name": "Review Sealed Change",
      "event_kind": "created",
      "event_source_id": "change-unit-review",
      "filter": "{ kind: { _eq: \"writer\" }, work_unit_id: { _like: \"change-unit:%\" } }",
      "source_collection": "WorkspaceReceipt",
      "workspace_authority": "readOnly"
    },
    {
      "correlation_field": "work_unit_id",
      "display_name": "Integrate Accepted Change",
      "event_kind": "created",
      "event_source_id": "change-unit-integrate",
      "filter": "{ status: { _eq: \"accepted\" }, work_unit_id: { _like: \"change-unit:%\" }, handoff_id: { _like: \"change-unit:%\" } }",
      "source_collection": "ChangeUnitClosure",
      "workspace_authority": "integrate"
    },
    {
      "correlation_field": "source_handoff_id",
      "display_name": "Record Integration",
      "event_kind": "created",
      "event_source_id": "change-unit-record",
      "filter": "{ source_collection: { _eq: \"ChangeUnitClosure\" }, terminal_state: { _eq: \"completed\" }, source_handoff_id: { _like: \"change-unit:%\" }, trigger_id: { _eq: \"change-unit-integrate\" } }",
      "source_collection": "FireOutcome"
    },
    {
      "correlation_field": "work_unit_id",
      "display_name": "Record Rejection",
      "event_kind": "created",
      "event_source_id": "change-unit-rejected",
      "filter": "{ status: { _eq: \"rejected\" }, work_unit_id: { _like: \"change-unit:%\" }, handoff_id: { _like: \"change-unit:%\" } }",
      "source_collection": "ChangeUnitClosure",
      "workspace_authority": "readOnly"
    },
    {
      "correlation_field": "source_handoff_id",
      "display_name": "Report failed writer attempt",
      "event_kind": "created",
      "event_source_id": "change-unit-failed-writer",
      "filter": "{ source_collection: { _eq: \"CallbackResult\" }, terminal_state: { _in: [\"failed\", \"interrupted\"] }, source_handoff_id: { _like: \"change-unit:%\" }, trigger_id: { _eq: \"change-unit-write\" } }",
      "source_collection": "FireOutcome"
    },
    {
      "correlation_field": "source_handoff_id",
      "display_name": "Report failed reviewer attempt",
      "event_kind": "created",
      "event_source_id": "change-unit-failed-reviewer",
      "filter": "{ source_collection: { _eq: \"WorkspaceReceipt\" }, terminal_state: { _in: [\"failed\", \"interrupted\"] }, source_handoff_id: { _like: \"change-unit:%\" }, trigger_id: { _eq: \"change-unit-review\" } }",
      "source_collection": "FireOutcome"
    },
    {
      "correlation_field": "source_handoff_id",
      "display_name": "Report failed integrator attempt",
      "event_kind": "created",
      "event_source_id": "change-unit-failed-integrator",
      "filter": "{ source_collection: { _eq: \"ChangeUnitClosure\" }, terminal_state: { _in: [\"failed\", \"interrupted\"] }, source_handoff_id: { _like: \"change-unit:%\" }, trigger_id: { _eq: \"change-unit-integrate\" } }",
      "source_collection": "FireOutcome"
    }
