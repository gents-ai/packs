{
  "agent_behaviors": [
    {
      "behavior_id": "change-unit-writer",
      "context_id": "change-unit-writer-context",
      "description": "Implements one exact-path change in a host-sealed isolated workspace.",
      "display_name": "Change Writer",
      "inference_profile_id": "gents:inference-slot:writer"
    },
    {
      "behavior_id": "change-unit-reviewer",
      "context_id": "change-unit-reviewer-context",
      "description": "Independently reviews the sealed workspace and binds acceptance to its writer receipt.",
      "display_name": "Change Reviewer",
      "inference_profile_id": "gents:inference-slot:reviewer"
    },
    {
      "behavior_id": "change-unit-integrator",
      "context_id": "change-unit-integrator-context",
      "description": "Acknowledges host-owned integration of an accepted sealed workspace.",
      "display_name": "Change Integrator",
      "inference_profile_id": "gents:inference-slot:integrator"
    },
    {
      "behavior_id": "change-unit-record",
      "context_id": "change-unit-record-context",
      "description": "Records host-confirmed integration from the integrator receipt.",
      "display_name": "Integration Recorder",
      "inference_profile_id": "gents:inference-slot:integrator"
    },
    {
      "behavior_id": "change-unit-rejected",
      "context_id": "change-unit-rejected-context",
      "description": "Records a rejected review as the unit's terminal result.",
      "display_name": "Rejection Recorder",
      "inference_profile_id": "gents:inference-slot:integrator"
    },
    {
      "behavior_id": "change-unit-failed",
      "context_id": "change-unit-failed-context",
      "description": "Records a failed or interrupted stage as the unit's terminal result.",
      "display_name": "Failure Recorder",
      "inference_profile_id": "gents:inference-slot:integrator"
    }
  ],
  "agent_principal": {},
  "callback_bindings": [
    {
      "binding_id": "change-unit-workspace",
