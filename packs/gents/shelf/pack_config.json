  "callbacks": [
    {
      "callback_id": "shelf-plan",
      "display_name": "Shelf plan",
      "handler": {
        "correlation_field": "run_id",
        "digest": "sha256:cc6215a8c74aac6009fad787525d57a98d76b041f936fb5381f8720f93b59a0e",
        "kind": "plugin",
        "outputs": [
          {
            "cardinality": "many",
            "collection": "ShelfChunk",
            "correlation_field": "run_id",
            "name": "chunks",
            "required": false,
            "schema": "ShelfChunk/v1"
          }
        ],
        "plugin": "gents/ocr"
      }
    },
    {
      "callback_id": "shelf-extract",
      "display_name": "Shelf extract",
      "handler": {
        "correlation_field": "run_id",
        "digest": "sha256:cc6215a8c74aac6009fad787525d57a98d76b041f936fb5381f8720f93b59a0e",
        "kind": "plugin",
        "outputs": [
          {
            "cardinality": "one",
            "collection": "ShelfExtract",
            "correlation_field": "run_id",
            "name": "document",
            "required": true,
            "schema": "ShelfExtract/v1"
          },
          {
            "cardinality": "many",
            "collection": "ShelfPage",
            "correlation_field": "run_id",
            "name": "pages",
            "required": false,
            "schema": "ShelfPage/v1"
          },
          {
            "cardinality": "many",
            "collection": "ShelfFigure",
            "correlation_field": "run_id",
            "name": "figures",
            "required": false,
            "schema": "ShelfFigure/v1"
          }
        ],
        "plugin": "gents/ocr"
      }
    },
    {
      "callback_id": "shelf-assemble",
      "display_name": "Assemble structured book",
      "handler": {
        "kind": "plugin",
        "plugin": "shelf_structure",
        "digest": "",
        "correlation_field": "run_id",
        "outputs": [
          {
            "name": "book",
            "collection": "ShelfBook",
            "schema": "ShelfBook/v1",
            "correlation_field": "run_id",
            "cardinality": "one",
            "required": true
          },
          {
            "name": "chapters",
            "collection": "ShelfChapter",
            "schema": "ShelfChapter/v1",
            "correlation_field": "run_id",
            "cardinality": "many",
            "required": true
          },
          {
            "name": "report",
            "collection": "ShelfStructureReport",
            "schema": "ShelfStructureReport/v1",
            "correlation_field": "run_id",
            "cardinality": "one",
            "required": true
          }
        ]
