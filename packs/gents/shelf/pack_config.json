          "fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            },
            {
              "name": "title",
              "required": true
            },
            {
              "name": "author",
              "required": true
            },
            {
              "name": "language",
              "required": true
            },
            {
              "name": "sources_json",
              "required": true
            },
            {
              "name": "entries_json",
              "required": true
            },
            {
              "name": "review_notes",
              "required": true
            }
