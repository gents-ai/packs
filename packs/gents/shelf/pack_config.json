      "surface_id": "shelf-analyze-writes",
      "display_name": "Shelf analyze output",
      "entries": [
        {
          "tool_name": "write_shelf_analyze",
          "collection": "ShelfChunkAnalysis",
          "description": "Persist the analyze result for this book run.",
          "fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            },
            {
              "name": "chunk",
              "required": true
            },
            {
              "name": "expected_total",
              "required": true
            },
            {
              "name": "source",
              "fill": {
                "source_field": "source"
              }
            },
            {
              "name": "complete",
              "required": true
            },
            {
              "name": "page_count",
              "required": true
            },
            {
              "name": "analysis",
              "required": true
            },
            {
              "name": "error",
              "required": true
            }
          ],
          "output_obligation": {
            "scope": "trigger",
            "minimum_writes": 1
          }
        },
        {
          "kind": "query",
          "tool_name": "read_shelf_chunks",
          "collection": "ShelfChunk",
          "description": "Read the entire planned chunk set for this run. Its count is expected_total. Select only needed fields.",
