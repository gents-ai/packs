    {
      "surface_id": "shelf-analyze-writes",
      "display_name": "Shelf analyze output",
      "entries": [
        {
          "tool_name": "write_shelf_analyze",
          "collection": "ShelfChunkAnalysis",
          "description": "Persist the analyze result for this book run.",
          "fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            },
            {
              "name": "chunk",
              "required": true
            },
            {
              "name": "expected_total",
              "required": true
            },
            {
              "name": "source",
              "fill": {
                "source_field": "source"
              }
            },
            {
              "name": "complete",
              "required": true
            },
            {
              "name": "page_count",
              "required": true
            },
            {
              "name": "analysis",
              "required": true
            },
            {
              "name": "error",
              "required": true
            }
          ],
          "output_obligation": {
            "scope": "trigger",
            "minimum_writes": 1
          }
        },
        {
          "kind": "query",
          "tool_name": "read_shelf_chunks",
          "collection": "ShelfChunk",
          "description": "Read the entire planned chunk set for this run. Its count is expected_total. Select only needed fields.",
          "fields": [
            "chunk",
            "source",
            "pages"
          ],
          "filter_fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            }
          ]
        }
      ]
    },
    {
      "surface_id": "shelf-outline-writes",
      "display_name": "Shelf outline output",
      "entries": [
        {
          "tool_name": "write_shelf_outline",
          "collection": "ShelfOutline",
          "description": "Persist the outline result for this book run. entries_json is a JSON array of {title,source,page,level,matter_type,content_type,review_notes}. page is a physical 1-based integer; level is 1-6; matter_type must be exactly front_matter, body, or back_matter; content_type is a nonempty section classification.",
          "fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            },
            {
              "name": "title",
              "required": true
            },
            {
              "name": "author",
              "required": true
            },
            {
              "name": "language",
              "required": true
            },
            {
              "name": "sources_json",
              "required": true
            },
            {
              "name": "entries_json",
              "required": true
            },
            {
              "name": "review_notes",
              "required": true
            }
          ],
          "output_obligation": {
            "scope": "trigger",
            "minimum_writes": 1
          }
        },
        {
          "kind": "query",
          "tool_name": "read_shelf_chunks",
          "collection": "ShelfChunk",
          "description": "Read the entire planned chunk set for this run. Its count is expected_total. Select only needed fields.",
          "fields": [
            "chunk",
            "source",
            "pages"
          ],
          "filter_fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            }
          ]
        },
        {
          "kind": "query",
          "tool_name": "read_shelf_analyses",
          "collection": "ShelfChunkAnalysis",
          "description": "Read all chunk analyses for this run.",
          "fields": [
            "chunk",
            "source",
            "complete",
            "analysis",
            "error"
          ],
          "filter_fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            }
          ]
        },
        {
          "kind": "query",
          "tool_name": "read_shelf_extractions",
          "collection": "ShelfExtract",
          "description": "Check extraction completeness for this run without loading raw text.",
          "fields": [
            "chunk",
            "source",
            "complete",
            "error",
            "cursor",
            "warnings",
            "page_count"
          ],
          "filter_fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            }
          ]
        },
        {
          "kind": "query",
          "tool_name": "read_shelf_job",
          "collection": "ShelfJob",
          "description": "Read the input file or explicit ordered source list for this run.",
          "fields": [
            "path",
            "files"
          ],
          "filter_fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            }
          ]
        },
        {
          "kind": "query",
          "tool_name": "read_shelf_page_index",
          "collection": "ShelfPage",
          "description": "List source page numbers and document IDs for this book run, without text. Optional source selects one PDF. If the result reaches the limit, do not assume the index is complete. For a single source select fields [_docID,page]. If line truncation hides tail rows, repeat selecting only [_docID], then read the previously unseen IDs with read_shelf_page. A count of 1000 requires smaller source scope; never certify an incomplete index.",
          "fields": [
            "_docID",
            "source",
            "page"
          ],
          "filter_fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            },
            {
              "name": "source"
            }
          ]
        },
        {
          "kind": "query",
          "tool_name": "read_shelf_page",
          "collection": "ShelfPage",
          "description": "Read one page of this book run by its _docID from read_shelf_page_index. Use field_page when the result supplies a truncated text field. Example: {\"_docID\":\"bae-...\",\"fields\":[\"page\",\"markdown\"]}. The leading underscore in _docID is required; docID is invalid.",
          "fields": [
            "_docID",
            "source",
            "page",
            "markdown"
          ],
          "filter_fields": [
            {
              "name": "run_id",
              "fill": "correlation"
            },
            {
              "name": "_docID",
              "required": true
            }
          ]
        }
      ]
    },
