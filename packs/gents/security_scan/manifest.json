{
  "assets": [
    "README.md",
    "agent_behaviors/scan_investigate/system_prompt.md",
    "agent_behaviors/scan_plan/system_prompt.md",
    "agent_behaviors/scan_report/system_prompt.md",
    "agent_behaviors/scan_revalidate/system_prompt.md",
    "experiment.json",
    "pack_config.json",
    "plugins/secscan.afb",
    "plugins/secscan/TOOL.md",
    "schemas/candidate_finding.graphql",
    "schemas/finding.graphql",
    "schemas/finding_verdict.graphql",
    "schemas/investigation_batch.graphql",
    "schemas/investigation_result.graphql",
    "schemas/revalidation_summary.graphql",
    "schemas/scan_job.graphql",
    "schemas/scan_report.graphql",
    "tasks/scan_investigate_task/prompt.md",
    "tasks/scan_plan_task/prompt.md",
    "tasks/scan_report_task/prompt.md",
    "tasks/scan_revalidate_task/prompt.md",
    "tests/install.json"
  ],
  "authors": [
    "gents-ai contributors"
  ],
  "config": "pack_config.json",
  "dependencies": [],
  "description": "Whole-codebase security scan: free regex pre-scan -> batch planner -> investigator fan-out -> adversarial revalidation -> report",
  "inference_slots": [
    {
      "behaviors": [
        "scan-plan",
        "scan-report"
      ],
      "description": "Plans scan batches and produces the final report.",
      "name": "coordinator"
    },
    {
      "behaviors": [
        "scan-investigate"
      ],
      "description": "Investigates candidate findings in parallel.",
      "name": "scanner"
    },
    {
      "behaviors": [
        "scan-revalidate"
      ],
      "description": "Adversarially revalidates candidate findings.",
      "name": "verifier"
    }
  ],
  "kind": "documents",
  "manifest_version": 1,
  "name": "security_scan",
  "namespace": "gents",
  "plugins": [
    {
      "artifact": "plugins/secscan.afb",
      "description": "Runs the security_scan matcher registry (the free regex pre-scan) over a directory or an explicit set of file contents, and formats the candidates block the runner seeds into ScanJob.",
      "input_schema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "description": "Absolute path to the directory to walk (gitignore-aware, hidden files skipped, files over 1 MiB or not valid UTF-8 skipped). Readable only when the plugin has been granted read access to it."
              },
              "max_payload_chars": {
                "type": "integer",
                "minimum": 0,
                "description": "Caps how much matched-line evidence the payload carries before remaining files are demoted to path-only inventory lines. Defaults to 49152."
              }
            },
            "required": ["root"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "description": "Explicit file contents to scan; no filesystem access is used.",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "Path recorded in the output, forward slashes; drives the matcher extension gate."
                    },
                    "content": {
                      "type": "string",
                      "description": "The file's text content."
                    }
                  },
                  "required": ["path", "content"],
                  "additionalProperties": false
                }
              },
              "max_payload_chars": {
                "type": "integer",
                "minimum": 0,
                "description": "Caps how much matched-line evidence the payload carries before remaining files are demoted to path-only inventory lines. Defaults to 49152."
              }
            },
            "required": ["files"],
            "additionalProperties": false
          }
        ]
      },
      "instructions": "plugins/secscan/TOOL.md",
      "language": "rust",
      "name": "secscan",
      "source": "plugins/secscan"
    }
  ],
  "schemas": [
    "schemas/candidate_finding.graphql",
    "schemas/finding.graphql",
    "schemas/finding_verdict.graphql",
    "schemas/investigation_batch.graphql",
    "schemas/investigation_result.graphql",
    "schemas/revalidation_summary.graphql",
    "schemas/scan_job.graphql",
    "schemas/scan_report.graphql"
  ],
  "tags": [
    "example"
  ],
  "version": "1.0.0"
}
