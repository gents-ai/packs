{"jq":[{"name":"game collections are branchable","expr":"(.assets[\"schemas/game.graphql\"] | contains(\"type TicTacToeGame @branchable\") and contains(\"type TicTacToeMove @branchable\"))"},{"name":"the page can only call declared game tools","expr":".manifest.ux[0].data == [{\"surface\":\"tic-tac-toe-board\",\"tools\":[\"list_games\",\"list_moves\",\"create_game\",\"create_move\"]}]"},{"name":"move lookup requires the game identifier","expr":".config.datastore_tool_surfaces[0].entries.entries[] | select(.tool_name == \"list_moves\") | .filter_fields == [{\"name\":\"game_id\",\"required\":true}]"}]}
