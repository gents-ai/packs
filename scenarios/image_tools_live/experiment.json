{
  "name": "image_tools_live",
  "description": "image_tools: make 256px thumbnails of the photos in ./photos",
  "init": {
    "inference_url": "${GENTS_LIVE_ENDPOINT:-http://workstation-1:8000/v1}",
    "model_name": "${GENTS_LIVE_MODEL:-GLM-5.3-Flash-NVFP4}",
    "backend_preset": "vllm",
    "openai_wire_api": "chat-completions",
    "tool_root": "${GENTS_LIVE_ROOT}",
    "tool_root_env_var": "GENTS_LIVE_ROOT"
  },
  "allowed_folders": [{"path": "photos", "access": "read_write"}],
  "seed": {
    "collection": "ImageToolsLiveJob",
    "job_id_field": "job_id",
    "prompt_field": "prompt"
  },
  "default_prompt": "Make thumbnails of every photo in the folder ${GENTS_LIVE_ROOT}/photos: resize each to fit within 256x256 pixels and save each one next to its original with the suffix _thumb. Then list the thumbnails you wrote with their sizes.",
  "expect": {
    "trigger_ids": ["image-tools-live"],
    "signed_provenance": true,
    "projections": ["atif"],
    "required_tool_call_trigger_ids": ["image-tools-live"],
    "tool_calls": [
      {"trigger_id": "image-tools-live", "tool_name": "image_tools", "result_contains": ["harbor_thumb"]},
      {"trigger_id": "image-tools-live", "tool_name": "image_tools", "result_contains": ["meadow_thumb"]},
      {"trigger_id": "image-tools-live", "tool_name": "image_tools", "result_contains": ["sunset_thumb"]}
    ]
  },
  "await_timeout_secs": ${GENTS_LIVE_AWAIT_TIMEOUT_SECS:-600}
}
