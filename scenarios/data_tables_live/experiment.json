{
  "name": "data_tables_live",
  "description": "data_tables: answer the top region from sales.csv and export per-region totals to totals.csv",
  "init": {
    "inference_url": "${GENTS_LIVE_ENDPOINT:-http://workstation-1:8000/v1}",
    "model_name": "${GENTS_LIVE_MODEL:-GLM-5.3-Flash-NVFP4}",
    "backend_preset": "vllm",
    "openai_wire_api": "chat-completions",
    "tool_root": "${GENTS_LIVE_ROOT}",
    "tool_root_env_var": "GENTS_LIVE_ROOT"
  },
  "allowed_folders": [{"path": ".", "access": "read_write"}],
  "seed": {
    "collection": "DataTablesLiveJob",
    "job_id_field": "job_id",
    "prompt_field": "prompt"
  },
  "default_prompt": "Which region had the highest total revenue in ${GENTS_LIVE_ROOT}/sales.csv? Also export the total revenue per region to totals.csv in the folder ${GENTS_LIVE_ROOT}.",
  "expect": {
    "trigger_ids": ["data-tables-live"],
    "signed_provenance": true,
    "projections": ["atif"],
    "required_tool_call_trigger_ids": ["data-tables-live"],
    "tool_calls": [
      {"trigger_id": "data-tables-live", "tool_name": "data_tables", "result_contains": ["totals.csv"]}
    ]
  },
  "await_timeout_secs": ${GENTS_LIVE_AWAIT_TIMEOUT_SECS:-600}
}
